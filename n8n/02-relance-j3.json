        "jsCode": "const lead = $input.item.json;\nconst payload = {\n  external_id: 'j3-' + lead.lead_external_id + '-' + new Date().toISOString().slice(0, 10),\n  automation_key: 'proposal_follow_up_j3',\n  status: 'success',\n  title: 'Relance J+3 envoyée à ' + lead.name,\n  lead_external_id: lead.lead_external_id,\n  respect_pause: true,\n  detail: { channel: 'email' },\n};\nconst body = JSON.stringify(payload);\nconst timestamp = Math.floor(Date.now() / 1000);\nreturn { json: { body, timestamp, to_sign: `${timestamp}.${body}` } };"
      },
