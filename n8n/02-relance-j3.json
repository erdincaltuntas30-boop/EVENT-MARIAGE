    {
      "parameters": {
        "jsCode": "const req = $('Relance demandée depuis l\\'app').first().json;\nconst body = JSON.stringify(req.body); // l'app envoie un JSON compact : la sérialisation est identique\nconst ts = req.headers['x-em-timestamp'];\nconst fresh = Math.abs(Date.now() / 1000 - Number(ts)) < 300;\nreturn [{ json: { to_sign: `${ts}.${body}`, received: (req.headers['x-em-signature'] || '').replace('sha256=', ''), fresh, request: req.body } }];"
      },
      "id": "85c8dc51-c490-4d7c-9085-25e79ca404f2",
      "name": "Préparer la vérification",
      "type": "n8n-nodes-base.code",
