      "parameters": {
        "jsCode": "// Construit le corps EXACT qui sera envoyé (la signature porte sur cette chaîne).\nconst payload = (() => {\n  const r = $('Préparer la vérification').first().json.request;\n  return {\n    external_id: 'manual-' + $execution.id,\n    request_id: r.request_id,          // clôt la ligne « En cours » créée par l'app\n    automation_key: 'proposal_follow_up_j3',\n    status: 'success',\n    title: 'Relance envoyée à ' + [r.lead.first_name, r.lead.last_name].filter(Boolean).join(' '),\n    lead_external_id: r.lead.external_id,\n  };\n})();\nconst body = JSON.stringify(payload);\nconst timestamp = Math.floor(Date.now() / 1000);\nreturn [{ json: { body, timestamp, to_sign: `${timestamp}.${body}` } }];"
      },
