      "id": "a46c7f7b-4334-4774-af15-9619b832390a",
      "name": "Config Event Mariage",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ],
      "notes": "Renseignez l'URL de l'app et la clé API (Réglages › Intégrations).",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// Signature d'un GET : le corps est vide.\nconst timestamp = Math.floor(Date.now() / 1000);\nreturn [{ json: { timestamp, to_sign: `${timestamp}.` } }];"
      },
      "id": "ef18a030-1d4f-423c-8ed7-acca408a9810",
      "name": "Construire la vérification",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.to_sign }}",
        "dataPropertyName": "signature",
        "secret": "={{ $('Config Event Mariage').first().json.secret }}",
        "encoding": "hex"
      },
      "id": "d0260409-2e38-485a-acf9-046678154564",
      "name": "Signer la vérification",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        960,
        300
      ],
      "notes": "HMAC-SHA256(secret, timestamp + '.' + corps)",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config Event Mariage').first().json.api_url }}/api/v1/automations/review_request",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config Event Mariage').first().json.key_id }}"
            },
            {
              "name": "X-EM-Timestamp",
              "value": "={{ $json.timestamp }}"
            },
            {
              "name": "X-EM-Signature",
              "value": "=sha256={{ $json.signature }}"
            }
          ]
        },
        "options": {}
      },
      "id": "cb63fb3d-13e3-41c5-abe2-194c2a23fe8c",
      "name": "Automatisation active ?",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1200,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "0b5cbc3e-6c02-480d-82a7-6c0536bbc9cf",
              "leftValue": "={{ $json.enabled }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b378b2f8-cf4f-4be0-9c28-e9ccfe8e4d7c",
      "name": "Si activée dans l'app",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// À remplacer par votre source (Google Agenda, CRM, Airtable…).\n// event_external_id = identifiant du mariage tel qu'envoyé à Event Mariage (/api/ingest/event).\nreturn [\n  { json: { event_external_id: 'demo-event-1', couple: 'Exemple & Exemple', email: 'maries@exemple.fr' } },\n];"
      },
      "id": "10ce7b04-1032-4b2c-8063-f429b36ac1d9",
      "name": "Mariages d'il y a 2 jours",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        300
      ]
    },
    {
      "parameters": {},
      "id": "7199ab73-abbc-4991-a54a-1519903914b2",
      "name": "Envoyer la demande d'avis",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1920,
        300
      ],
      "notes": "À remplacer par votre email de remerciement avec liens Google / Mariages.net.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const e = $input.item.json;\nconst payload = {\n  external_id: 'review-' + e.event_external_id,   // une seule demande par mariage\n  automation_key: 'review_request',\n  status: 'success',\n  title: \"Demande d'avis envoyée à \" + e.couple,\n  event_external_id: e.event_external_id,\n  respect_pause: true,                             // 409 si l'automatisation est en pause dans l'app\n  detail: { channel: 'email' },\n};\nconst body = JSON.stringify(payload);\nconst timestamp = Math.floor(Date.now() / 1000);\nreturn { json: { body, timestamp, to_sign: `${timestamp}.${body}` } };"
      },
      "id": "495edf8e-d12c-4d2e-805d-6d27da2b23ed",
      "name": "Construire le compte-rendu",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2160,
        300
      ]
    },
    {
