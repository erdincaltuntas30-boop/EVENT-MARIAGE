        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.to_sign }}",
        "dataPropertyName": "signature",
        "secret": "={{ $('Config Event Mariage').first().json.secret }}",
        "encoding": "hex"
      },
      "id": "eed6a965-559d-4e60-b010-6fb87c320d7f",
      "name": "Signer le compte-rendu",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        2400,
        300
      ],
      "notes": "HMAC-SHA256(secret, timestamp + '.' + corps)",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config Event Mariage').first().json.api_url }}/api/ingest/automation-run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config Event Mariage').first().json.key_id }}"
            },
            {
