      "id": "b4c731a3-3c3a-40b5-849a-b832e9aea677",
      "name": "Config Event Mariage",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        300
      ],
      "notes": "Renseignez l'URL de l'app et la clé API (Réglages › Intégrations).",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// Construit le corps EXACT qui sera envoyé (la signature porte sur cette chaîne).\nconst payload = (() => {\n  const d = $('Nouveau lead (formulaire, Instagram, Mariages.net…)').first().json.body ?? {};\n  return {\n    external_id: String(d.id ?? d.submission_id ?? $execution.id),\n    source: d.source ?? 'form',            // form | instagram | mariages_net | email | other\n    first_name: d.first_name ?? d.prenom ?? 'Inconnu',\n    last_name: d.last_name ?? d.nom ?? null,\n    partner_name: d.partner_name ?? d.conjoint ?? null,\n    email: d.email ?? null,\n    phone: d.phone ?? d.telephone ?? null,\n    wedding_date: d.wedding_date ?? d.date_mariage ?? null,   // AAAA-MM-JJ\n    budget: d.budget ? Number(d.budget) : null,               // en euros\n    guest_count: d.guest_count ? Number(d.guest_count) : null,\n    venue: d.venue ?? d.lieu ?? null,\n    message: d.message ?? null,\n  };\n})();\nconst body = JSON.stringify(payload);\nconst timestamp = Math.floor(Date.now() / 1000);\nreturn [{ json: { body, timestamp, to_sign: `${timestamp}.${body}` } }];"
      },
      "id": "354f8864-1d11-44b9-873e-aec0daa8d161",
      "name": "Construire le lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.to_sign }}",
        "dataPropertyName": "signature",
        "secret": "={{ $('Config Event Mariage').first().json.secret }}",
        "encoding": "hex"
      },
      "id": "c8e31c97-ea28-4ae2-aeea-0a1d5d148609",
      "name": "Signer le lead",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        960,
        300
      ],
      "notes": "HMAC-SHA256(secret, timestamp + '.' + corps)",
      "notesInFlow": true
    },
    {
