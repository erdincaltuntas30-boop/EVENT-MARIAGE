      "id": "2af87822-1b67-4457-9312-5f77200b8b3c",
      "name": "Envoyer la réponse instantanée",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1440,
        300
      ],
      "notes": "À remplacer par votre envoi d'email ou de message (Gmail, Brevo, Instagram…).",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// Construit le corps EXACT qui sera envoyé (la signature porte sur cette chaîne).\nconst payload = (() => {\n  const lead = JSON.parse($('Construire le lead').first().json.body);\n  return {\n    external_id: 'reply-' + $execution.id,\n    automation_key: 'lead_instant_reply',\n    status: 'success',\n    title: 'Réponse envoyée à ' + [lead.first_name, lead.last_name].filter(Boolean).join(' '),\n    lead_external_id: lead.external_id,\n    first_response: true,\n    detail: { channel: 'email' },\n  };\n})();\nconst body = JSON.stringify(payload);\nconst timestamp = Math.floor(Date.now() / 1000);\nreturn [{ json: { body, timestamp, to_sign: `${timestamp}.${body}` } }];"
      },
