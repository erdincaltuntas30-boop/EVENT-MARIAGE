# ── Supabase (Project Settings › API) ───────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service role : uniquement côté serveur, ne jamais l'exposer au navigateur
SUPABASE_SERVICE_ROLE_KEY=

# ── Application ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Chiffre les secrets (clés API, secret sortant). Générer avec : openssl rand -base64 32
APP_ENCRYPTION_KEY=

# ── Données de démo (npm run seed) ──────────────────────────────────
DEMO_USER_EMAIL=demo@event-mariage.test
DEMO_USER_PASSWORD=
DEMO_WITNESS_EMAIL=temoin@event-mariage.test

# ── Test d'ingestion (npm run send-test-event) — affichés par npm run seed
EM_API_KEY_ID=
EM_API_SECRET=
